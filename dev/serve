#!/usr/bin/env bash
# Build the web app and run api + worker in one container, with the photo libraries read-only (and masks,
# when ./dev/ml-models has written the model weights).
#   ./dev/serve                         local-only config, no Immich, on 127.0.0.1:8090
#   SIDECAR_CONFIG=deploy/sidecar.dev-immich.toml ./dev/serve   against the real Immich (host network)
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
config="${SIDECAR_CONFIG:-deploy/sidecar.dev.toml}"
mounts="-v /mnt/storage/Photography:/mnt/storage/Photography:ro -v /mnt/storage/immich_library:/data:ro"
if grep -q '127.0.0.1:2283' "$here/$config"; then net="--network host"; else net="-p 127.0.0.1:${SIDECAR_PORT:-8090}:8080"; fi
# Masks too, as in the -ml image, once ./dev/ml-models has written the weights.
ml=""
if [ -f "$here/target/ml-models/birefnet.bpk" ]; then
  ml="cargo build -q --release -p sidecar-ml && export SIDECAR_ML=/cache/target/release/sidecar-ml SIDECAR_ML_MODELS=/src/target/ml-models &&"
fi
SIDECAR_DEV_EXTRA="$net $mounts ${SIDECAR_DEV_EXTRA:-}" \
  "$here/dev/run" bash -c "cd web && npm run -s generate && npm run -s build && cd .. && $ml cargo run -q --release -p sidecar -- dev --config $config"

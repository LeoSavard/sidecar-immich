{
	"name": "Sidecar",
	"short_name": "Sidecar",
	"description": "A RAW editor beside Immich",
	"start_url": "/",
	"display": "standalone",
	"background_color": "#161616",
	"theme_color": "#161616",
	"icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }],
	"share_target": {
		"action": "/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"files": [{ "name": "media", "accept": ["image/*", "application/octet-stream", ".nef", ".nrw", ".arw", ".srf", ".sr2", ".raf", ".cr2", ".cr3", ".crw", ".dng", ".orf", ".rw2", ".pef", ".srw", ".x3f", ".3fr", ".iiq", ".erf", ".mef", ".mos", ".rwl"] }]
		}
	}
}
